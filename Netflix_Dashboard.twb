      <aliases enabled='yes' />
      <column caption='Movie_Duration' datatype='integer' name='[Calculation_1275178590650368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [type] = &quot;Movie&quot; THEN&#13;&#10;INT(SPLIT([duration], &quot; &quot;, 1))&#13;&#10;END' />
      </column>
      <column caption='TV_Seasons' datatype='integer' name='[Calculation_1275178591129601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [type]=&quot;TV Show&quot; THEN&#13;&#10;INT(REPLACE(REPLACE([duration],&quot;Seasons&quot;,&quot;&quot;),&quot;Seasons&quot;,&quot;&quot;))&#13;&#10;END' />
      </column>
      <column caption='Content_Age' datatype='integer' name='[Calculation_1275178591776770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR(TODAY())-[release_year]' />
      </column>
      <column caption='Years_Until_Added' datatype='integer' name='[Calculation_1275178592346118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Year_added]-[release_year]' />
      </column>
      <column caption='Movies' datatype='integer' name='[Calculation_1275178601734151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [type]=&quot;Movie&quot; THEN 1&#13;&#10;END' />
      </column>
      <column caption='TV_shows' datatype='integer' name='[Calculation_1275178602389512]' role='measure' type='quantitative'>
